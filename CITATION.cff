    affiliation: >-
      INESC-ID, Instituto Superior Técnico, Universidade de Lisboa
license: MIT
repository-code: >-
  https://github.com/LuisRusso-INESC-ID/Heap-Permutations
keywords:
  - permutation generation
  - Heap's algorithm
  - Gray codes
  - symmetric group
version: 1.0.0
date-released: 2026-11-17
